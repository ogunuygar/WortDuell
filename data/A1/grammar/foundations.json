        "I see you."
      ],
      [
        "Er hilft mir.",
        "He helps me."
      ],
      [
        "Können Sie mir helfen?",
        "Can you help me?"
      ]
    ],
    "qs": [
      [
        "He is here: ___ ist hier.",
        "Er",
        [
          "Ihn",
          "Ihm"
        ],
        "Use er as a masculine subject."
      ],
      [
        "I see him: Ich sehe ___.",
        "ihn",
        [
          "er",
          "ihm"
        ],
        "Sehen takes an accusative object."
      ],
      [
        "I help you (du): Ich helfe ___.",
        "dir",
        [
          "dich",
          "du"
        ],
        "Helfen takes dative."
      ],
      [
