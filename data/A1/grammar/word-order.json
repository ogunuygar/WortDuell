    "title": "W-questions · Question words",
    "icon": "❔",
    "source": "German questions",
    "intro": "Choose the question word for the information you want, then add the conjugated verb. Wo asks where, wohin where to and woher where from.",
    "samples": [
      [
        "Wo bist du?",
        "Where are you?"
      ],
      [
        "Wohin gehst du?",
        "Where are you going?"
      ],
      [
        "Warum lernst du Deutsch?",
        "Why are you learning German?"
      ]
    ],
    "qs": [
      [
        "___ bist du? — Where are you?",
        "Wo",
        [
          "Wohin",
          "Woher"
        ],
        "Wo asks about a location."
      ],
      [
        "___ gehst du? — Where are you going?",
        "Wohin",
        [
          "Woher",
          "Wer"
        ],
        "Wohin asks about a destination."
      ],
      [
        "___ kommst du? — Where do you come from?",
        "Woher",
        [
          "Wohin",
          "Wo"
        ],
        "Woher asks about an origin."
      ],
      [
        "___ beginnt der Kurs? — When?",
        "Wann",
        [
          "Warum",
          "Wie"
        ],
        "Wann asks for a time."
      ],
      [
        "___ lernst du Deutsch? — Why?",
        "Warum",
        [
          "Wie",
          "Wer"
        ],
        "Warum asks for a reason."
      ],
      [
        "___ ist das? — Who is that?",
        "Wer",
        [
          "Was",
          "Wie"
        ],
        "Wer asks about a person."
      ],
      [
        "___ Buch ist das? — Whose?",
        "Wessen",
        [
          "Welche",
          "Wo"
        ],
        "Wessen asks who owns something."
      ],
      [
        "___ Farbe magst du?",
        "Welche",
        [
          "Welcher",
          "Welches"
        ],
        "Farbe is feminine, so use welche."
