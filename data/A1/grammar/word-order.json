[
  {
    "_order": 0,
    "id": "satzbau",
    "lv": "A1",
    "title": "Word order · Satzbau",
    "icon": "🧩",
    "source": "A1–A2 grammar worksheets",
    "intro": "In a statement the conjugated verb is the second element. If you start with a time expression, put the subject after the verb. Start a yes/no question with the verb.",
    "samples": [
      [
        "Ich lerne heute Deutsch.",
        "I’m learning German today."
      ],
      [
        "Heute lerne ich Deutsch.",
        "Today I’m learning German."
      ],
      [
        "Ich muss morgen arbeiten.",
        "I have to work tomorrow."
      ]
    ],
    "qs": [
      [
        "Choose the German for “I’m learning German today.”",
        "Heute lerne ich Deutsch.",
        [
          "Heute ich lerne Deutsch.",
          "Heute Deutsch lerne ich."
        ],
        "Heute fills the first position and lerne the second."
      ],
      [
        "Choose the German for “Are you working tomorrow?”",
        "Arbeitest du morgen?",
        [
          "Du arbeitest morgen?",
          "Morgen du arbeitest?"
        ],
        "Start a neutral yes/no question with the conjugated verb."
      ],
      [
        "Choose the German for “When are you working?”",
        "Wann arbeitest du?",
        [
          "Wann du arbeitest?",
          "Arbeitest wann du?"
        ],
        "Wann comes first, then the conjugated verb."
      ],
      [
        "Choose the German for “I have to work tomorrow.”",
        "Ich muss morgen arbeiten.",
        [
          "Ich muss arbeiten morgen.",
          "Ich morgen muss arbeiten."
        ],
        "Muss is conjugated and arbeiten stays at the end."
      ],
      [
        "Choose the German for “I’ll call you later.”",
        "Ich rufe dich später an.",
        [
          "Ich anrufe dich später.",
          "Ich rufe an dich später."
        ],
        "Anrufen splits: rufe … an."
      ],
      [
        "Choose the German for “Because I have to work tomorrow.”",
        "Weil ich morgen arbeiten muss.",
        [
          "Weil ich muss morgen arbeiten.",
          "Weil muss ich morgen arbeiten."
        ],
        "In the weil clause, the conjugated modal muss comes last."
      ],
      [
        "Choose the German for “I’m working in the office today.”",
        "Heute arbeite ich im Büro.",
        [
          "Heute ich arbeite im Büro.",
          "Heute arbeite im ich Büro."
        ],
        "Heute fills one position. Arbeite must follow it."
      ],
      [
        "Choose the German for “I worked yesterday.”",
        "Ich habe gestern gearbeitet.",
        [
          "Ich gearbeitet habe gestern.",
          "Ich gestern habe gearbeitet."
        ],
        "Perfekt uses habe plus the final participle gearbeitet."
      ]
    ]
  },
