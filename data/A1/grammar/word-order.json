      ],
      [
        "Könnten Sie das bitte wiederholen?",
        "Could you repeat that, please?"
      ]
    ],
    "qs": [
      [
        "Formal Sie: “Please wait.”",
        "Warten Sie bitte!",
        [
          "Warte bitte!",
          "Wartet Sie bitte!"
        ],
        "Formal commands use the verb followed by Sie."
      ],
      [
        "Informal du: “Come!”",
        "Komm!",
        [
          "Kommt!",
          "Kommen Sie!"
        ],
        "The du command for kommen is Komm!"
      ],
      [
        "Informal plural ihr: “Do it!”",
        "Macht!",
        [
          "Mach!",
          "Machen Sie!"
        ],
        "The ihr command matches the ihr verb form: Macht!"
      ],
      [
        "Formal Sie: “Take it!”",
        "Nehmen Sie!",
        [
          "Nimm Sie!",
          "Nehmt!"
        ],
        "Use the formal pattern Nehmen Sie!"
      ],
      [
        "Informal du: “Give!”",
        "Gib!",
        [
          "Gebt!",
          "Geben Sie!"
        ],
        "The du command for geben is Gib!"
      ],
      [
        "Which request is more polite?",
        "Könnten Sie mir bitte helfen?",
        [
          "Helfen du!",
          "Du helfen mir!"
        ],
        "Könnten Sie …? makes a request more tentative."
      ],
      [
        "Choose a polite café order.",
        "Ich hätte gern einen Kaffee.",
        [
          "Ich will einen Kaffee!",
          "Ich muss Kaffee!"
